---
title: Music Recommender RAG - current design
---
flowchart TD
    USER([User]) -->|"free text, e.g. 'chill songs for studying'"| CLI["rag.py CLI<br/>recommend_from_text()"]

    ENV[(".env<br/>GEMINI_API_KEY")] -.->|load_dotenv| CLI

    subgraph LOAD["Startup: recommender.load_songs()"]
        CSV[("data/songs.csv<br/>300 songs, 41 genres, 26 moods")] --> PARSE["Parse rows<br/>lowercase + canonical_genre()<br/>e.g. lo-fi -> lofi"]
        PARSE --> TEMPO["set_tempo_range()<br/>TEMPO_MIN / TEMPO_MAX = catalog min / max"]
        PARSE --> CATALOG[("In-memory song list")]
    end

    CLI --> LOAD

    subgraph UNDERSTAND["Step 1 - Query understanding (Gemini)"]
        PROMPT1["System prompt lists valid genres, moods<br/>and the live tempo range"]
        GEM1{{"Gemini<br/>JSON mode"}}
        VALIDATE["Validate profile<br/>keep known keys, clamp numbers<br/>(energy 0-1, tempo to catalog range)"]
        PROMPT1 --> GEM1 --> VALIDATE
    end

    CATALOG -.->|genre + mood lists| PROMPT1
    TEMPO -.->|tempo range| PROMPT1
    CLI --> PROMPT1
    VALIDATE -->|"profile: genre, mood, energy,<br/>tempo, danceability, acousticness"| SCORE

    subgraph RETRIEVE["Step 2 - Retrieval (no API, runs offline)"]
        SCORE["score_song() for every song<br/>weights: mood .30, energy .20,<br/>genre .15, acoustic .15, tempo .10, dance .10"]
        SIM["Partial-credit similarity<br/>mood_sim / genre_sim<br/>(families + pairwise overrides)"]
        TOPK["heapq.nlargest(k=5)"]
        SCORE --- SIM
        SCORE --> TOPK
    end

    CATALOG --> SCORE

    subgraph GENERATE["Step 3 - Grounded generation (Gemini)"]
        CONTEXT["Build context: numbered list of the<br/>retrieved songs only, with attributes + score"]
        GEM2{{"Gemini<br/>'recommend ONLY from this list'"}}
        CONTEXT --> GEM2
    end

    TOPK -->|top-k songs| CONTEXT
    GEM2 --> ANSWER["Natural-language recommendations<br/>with a reason for each song"]
    ANSWER --> USER

    subgraph ERR["Error handling (GeminiError, friendly messages)"]
        FRIENDLY["_friendly_message()<br/>429 quota, 401/403 key, 404 model,<br/>5xx outage, network, safety, empty reply"]
        FB1["Step 1 failed:<br/>'Sorry, I couldn't work out your request'"]
        FB2["Step 3 failed:<br/>plain list of retrieved songs<br/>+ friendly note"]
    end

    GEM1 -. API error .-> FRIENDLY
    GEM2 -. API error .-> FRIENDLY
    FRIENDLY -.-> FB1
    FRIENDLY -.-> FB2
    FB1 -.-> USER
    FB2 -.-> USER
    TOPK -.->|used for fallback| FB2
